#!/bin/sh
#
# Refuse to commit a sealed post's plaintext into this public repository.
#
# src/content/blog/ is generated by scripts/blog-publish.ts from the private
# folio-sealed repo, and that script never copies a post marked `sealed: true`.
# A hand-copied file is the only way one gets here, so that is what this checks.

set -e

staged=$(git diff --cached --name-only --diff-filter=ACM -- 'src/content/blog/*.mdx')

if [ -z "$staged" ]; then
  exit 0
fi

leaked=""

for file in $staged; do
  # Only look at the frontmatter block, not the body — a post may legitimately
  # discuss the word "sealed" in its prose.
  if git show ":$file" | awk 'NR==1 && $0 != "---" { exit 1 }
                              NR>1 && $0 == "---" { exit 1 }
                              NR>1 { print }' 2>/dev/null |
     grep -qiE '^[[:space:]]*sealed[[:space:]]*:[[:space:]]*(true|yes)[[:space:]]*$'; then
    leaked="$leaked  $file\n"
  fi
done

if [ -n "$leaked" ]; then
  printf '\nBlocked: sealed post plaintext staged for a public repository.\n\n'
  printf "$leaked"
  printf '\nThese posts are marked sealed, so their bodies belong only in\n'
  printf 'folio-sealed. Unstage them and run: npm run blog:publish\n\n'
  exit 1
fi

exit 0
